#!/bin/bash
# Sync .desktop entries for Chrome-based browser-app windows so Waybar's
# taskbar shows correct app icons instead of the default browser icon.
#
# Chrome generates unique window classes for --app windows that encode the URL:
#   chrome-<domain>__<path_segments>-Default
# (first path slash -> __, subsequent slashes -> _)
#
# For each matching window:
#   1. Decodes the URL from the window class
#   2. If an omarchy-managed .desktop exists for that URL -> symlinks it
#   3. If not -> downloads the favicon and creates a new .desktop entry
#
# TODO: Subscribe to Hyprland 'openwindow' events via `hyprctl events`
#       and call this automatically instead of requiring manual runs.

set -euo pipefail

APP_DIR="${HOME}/.local/share/applications"
ICON_DIR="${APP_DIR}/icons"
mkdir -p "${ICON_DIR}"

# Browser class prefixes to match --app windows
BROWSER_PREFIXES=("chrome-" "brave-" "msedge-" "opera-" "vivaldi-" "helium-")

# Build jq filter for matching browser app windows
JQ_PREFIXES=""
for p in "${BROWSER_PREFIXES[@]}"; do
    JQ_PREFIXES+="${p}|"
done
JQ_PREFIXES="${JQ_PREFIXES%|}"
JQ_FILTER='.[] | select(.class | test("^('${JQ_PREFIXES}').+-Default$")) | {class: .class, title: .title} | @json'

synced=0
created=0
skipped=0

while IFS= read -r LINE; do
    [ -z "$LINE" ] && continue

    CLASS=$(echo "$LINE"   | jq -r '.class')
    TITLE=$(echo "$LINE"   | jq -r '.title')

    # Skip if .desktop entry already exists for this class
    if [ -f "${APP_DIR}/${CLASS}.desktop" ]; then
        skipped=$((skipped + 1))
        continue
    fi

    # Decode URL from window class.
    # Strip browser prefix (e.g. "chrome-").
    ENCODED="$CLASS"
    for p in "${BROWSER_PREFIXES[@]}"; do
        ENCODED="${ENCODED#"$p"}"
    done
    # Strip "-Default" suffix.
    ENCODED="${ENCODED%-Default}"

    # Decode: first __  -> /,  remaining _ -> /
    # NOTE: assumes no literal underscores in URL paths.
    # If a segment contains '_' it will be miscoded as '/'.
    # This is a known limitation of the heuristic format.
    if [[ "$ENCODED" == *__* ]]; then
        URL="https://${ENCODED/__/\/}"
        URL="${URL//_/\/}"
    else
        URL="https://${ENCODED}"
    fi

    # Extract domain for favicon (everything before first __ or _).
    DOMAIN=$(echo "$ENCODED" | sed 's|__.*||; s|_.*||')

    # Is there an omarchy-managed .desktop for this URL?
    MATCHING=""
    for desktop in "${APP_DIR}"/*.desktop; do
        [ -f "$desktop" ] || continue
        if grep -qF "Exec=omarchy-launch-webapp ${URL}" "$desktop" 2>/dev/null; then
            MATCHING="$desktop"
            break
        fi
    done

    if [ -n "$MATCHING" ]; then
        ln -sf "$MATCHING" "${APP_DIR}/${CLASS}.desktop"
        echo "  symlink ${CLASS}.desktop -> $(basename "$MATCHING")"
        synced=$((synced + 1))
    else
        echo "  create ${CLASS}.desktop (${DOMAIN})"

        ICON_PATH="${ICON_DIR}/${CLASS}.png"
        if [ ! -f "$ICON_PATH" ]; then
            curl -fsSL --connect-timeout 5 --max-time 10 \
                -o "$ICON_PATH" \
                "https://www.google.com/s2/favicons?domain=${DOMAIN}&sz=128" 2>/dev/null || true
        fi

        # Strip pid prefix like "(5183)" from window title
        APP_NAME=$(echo "$TITLE" | sed 's/^([0-9]*) //')
        [ -z "$APP_NAME" ] && APP_NAME="$DOMAIN"

        cat > "${APP_DIR}/${CLASS}.desktop" << DESKTOP_EOF
[Desktop Entry]
Version=1.0
Name=${APP_NAME}
Comment=${APP_NAME}
Exec=omarchy-launch-webapp ${URL}
Terminal=false
Type=Application
Icon=${ICON_PATH}
StartupNotify=true
DESKTOP_EOF

        created=$((created + 1))
    fi
done < <(hyprctl clients -j 2>/dev/null | jq -r "$JQ_FILTER")

# Refresh desktop database so app launchers see new entries
if command -v update-desktop-database &>/dev/null; then
    update-desktop-database "${APP_DIR}" &>/dev/null || true
fi

echo "Done: ${synced} synced, ${created} created, ${skipped} skipped"
