#!/bin/bash
# Sync .desktop entries for Chrome-based browser-app windows so Waybar's
# taskbar shows correct app icons instead of the default browser icon.
#
# Chrome generates unique window classes for --app windows that encode the URL:
#   chrome-<domain>__<path_segments>-Default
# (first path slash -> __, subsequent slashes -> _)
#
# Phase 1: Scans ALL .desktop files for omarchy web apps and creates symlinks
#          from the Chrome class name to the existing desktop entry.
# Phase 2: Scans running --app windows and creates .desktop entries with
#          favicons for any non-omarchy apps found running.

set -euo pipefail

APP_DIR="${HOME}/.local/share/applications"
ICON_DIR="${APP_DIR}/icons"
mkdir -p "${ICON_DIR}"

BROWSER_PREFIXES=("chrome-" "brave-" "msedge-" "opera-" "vivaldi-" "helium-")

encode_url_to_class() {
    local url="$1"
    local stripped="${url#https://}"
    stripped="${stripped#http://}"
    local domain="${stripped%%/*}"
    local path="${stripped#*/}"
    if [ "$path" = "$stripped" ]; then
        echo "chrome-${domain}-Default"
    else
        path="${path//\//_}"
        echo "chrome-${domain}__${path}-Default"
    fi
}

synced=0
created=0
skipped=0

# === Phase 1: Scan all .desktop files for omarchy web apps ===
for desktop in "${APP_DIR}"/*.desktop; do
    [ -f "$desktop" ] && [ ! -L "$desktop" ] || continue
    URL=$(grep "^Exec=omarchy-launch-webapp " "$desktop" | sed 's/^Exec=omarchy-launch-webapp //') || true
    [ -z "$URL" ] && continue

    CLASS=$(encode_url_to_class "$URL")
    SHADOW="${APP_DIR}/${CLASS}.desktop"

    # Check if shadow file already exists and is up to date
    if [ -f "$SHADOW" ]; then
        # Update if pointing at a different icon (e.g. omarchy updated the icon)
        CURRENT_TARGET=$(grep "^X-Omarchy-Source=" "$SHADOW" 2>/dev/null | cut -d= -f2-) || true
        if [ "$CURRENT_TARGET" = "$desktop" ]; then
            skipped=$((skipped + 1))
            continue
        fi
        rm -f "$SHADOW"
    fi

    ICON=$(grep "^Icon=" "$desktop" | head -1 | cut -d= -f2-)
    APP_NAME=$(grep "^Name=" "$desktop" | head -1 | cut -d= -f2-)

    cat > "$SHADOW" << SHADOW_EOF
[Desktop Entry]
Type=Application
NoDisplay=true
Name=${APP_NAME}
Icon=${ICON}
X-Omarchy-Source=${desktop}
SHADOW_EOF

    echo "  shadow ${CLASS}.desktop -> $(basename "$desktop")"
    synced=$((synced + 1))
done

# === Phase 2: Scan running windows for ad-hoc --app windows ===
JQ_PREFIXES=""
for p in "${BROWSER_PREFIXES[@]}"; do
    JQ_PREFIXES+="${p}|"
done
JQ_PREFIXES="${JQ_PREFIXES%|}"
JQ_FILTER='.[] | select(.class | test("^('${JQ_PREFIXES}').+-Default$")) | {class: .class, title: .title} | @json'

while IFS= read -r LINE; do
    [ -z "$LINE" ] && continue

    CLASS=$(echo "$LINE" | jq -r '.class')
    TITLE=$(echo "$LINE" | jq -r '.title')

    # Already handled in Phase 1 or previous run
    [ -f "${APP_DIR}/${CLASS}.desktop" ] && { skipped=$((skipped + 1)); continue; }

    ENCODED="$CLASS"
    for p in "${BROWSER_PREFIXES[@]}"; do
        ENCODED="${ENCODED#"$p"}"
    done
    ENCODED="${ENCODED%-Default}"

    if [[ "$ENCODED" == *__* ]]; then
        URL="https://${ENCODED/__/\/}"
        URL="${URL//_/\/}"
    else
        URL="https://${ENCODED}"
    fi

    DOMAIN=$(echo "$ENCODED" | sed 's|__.*||; s|_.*||')

    echo "  create ${CLASS}.desktop (${DOMAIN})"

    ICON_PATH="${ICON_DIR}/${CLASS}.png"
    if [ ! -f "$ICON_PATH" ]; then
        curl -fsSL --connect-timeout 5 --max-time 10 \
            -o "$ICON_PATH" \
            "https://www.google.com/s2/favicons?domain=${DOMAIN}&sz=128" 2>/dev/null || true
    fi

    APP_NAME=$(echo "$TITLE" | sed 's/^([0-9]*) //')
    [ -z "$APP_NAME" ] && APP_NAME="$DOMAIN"

    cat > "${APP_DIR}/${CLASS}.desktop" << DESKTOP_EOF
[Desktop Entry]
Version=1.0
Name=${APP_NAME}
Comment=${APP_NAME}
Exec=omarchy-launch-webapp ${URL}
Terminal=false
Type=Application
Icon=${ICON_PATH}
StartupNotify=true
DESKTOP_EOF

    created=$((created + 1))
done < <(hyprctl clients -j 2>/dev/null | jq -r "$JQ_FILTER")

if command -v update-desktop-database &>/dev/null; then
    update-desktop-database "${APP_DIR}" &>/dev/null || true
fi

echo "Done: ${synced} synced, ${created} created, ${skipped} skipped"
